{
  "schema": "ttfm_q5_factor_isolation_rule_v0.1",
  "status": "frozen_before_development_diagnostic_outcomes",
  "purpose": "Diagnose which response-blind geometry factors reproduce the frozen Q5 TTF-C false-positive inflation and power loss. This is not a replacement qualification and cannot alter Q5.",
  "prerequisite": {
    "q5_result_path": "results/ttfm_q5_geometry_stress_v0.1.json",
    "required_joint_q5_pass": false,
    "required_ttf_m_q5_pass": true,
    "required_ttf_c_q5_pass": false
  },
  "split": {
    "n_systems": 40,
    "train_systems": 20,
    "eval_systems": 20,
    "rule": "sp_000_through_sp_019_train_sp_020_through_sp_039_eval"
  },
  "geometry_profiles": [
    "balanced",
    "n_only",
    "clustering_only",
    "truncation_only",
    "missingness_only",
    "all_matched",
    "n_shift_only",
    "clustering_shift_only",
    "n_clustering_shift",
    "all_shifted"
  ],
  "response_families": [
    {"id": "private_mismatch", "response_mode": "null_private_mismatch", "amplitude": 3.0, "noise_sd": 0.8},
    {"id": "private_relation", "response_mode": "null_private_relation", "amplitude": 2.0, "noise_sd": 0.0},
    {"id": "shared_mismatch", "response_mode": "power_shared_mismatch", "amplitude": 2.0, "noise_sd": 0.8}
  ],
  "geometry_constants": {
    "nominal_n_levels": [30, 45, 60, 90, 120],
    "matched_n_counts": [4, 4, 4, 4, 4],
    "shifted_train_n_counts": [2, 3, 4, 5, 6],
    "shifted_eval_n_counts": [6, 5, 4, 3, 2],
    "matched_clustering_counts": [8, 7, 5],
    "shifted_train_clustering_counts": [12, 6, 2],
    "shifted_eval_clustering_counts": [3, 7, 10],
    "truncation_counts": [10, 5, 5],
    "missingness_counts": [8, 7, 5],
    "graph_fraction": 0.15,
    "bandwidth": 0.2,
    "prior_strength": 0.25,
    "prior_mean": 0.5,
    "segment_points": 5,
    "transition_width": 0.2
  },
  "diagnostic": {
    "replicates_per_cell": 100,
    "bootstrap_resamples": 999,
    "alpha_for_descriptive_rejection_fraction": 0.05,
    "master_seed": 20260916,
    "formal_pass_fail_forbidden": true,
    "candidate_selection_forbidden": true,
    "threshold_tuning_forbidden": true,
    "q5_reinterpretation_forbidden": true
  },
  "report": {
    "primary": ["ttf_c_rejection_fraction", "ttf_c_mean_statistic"],
    "secondary": ["ttf_m_rejection_fraction", "mean_train_effective_n", "mean_eval_effective_n", "mean_train_k", "mean_eval_k"],
    "reference_profile": "balanced",
    "interpretation": "factor-isolation only; larger deviations from balanced identify geometry components associated with the frozen Q5 failure but do not license a repaired method"
  },
  "claim_firewall": {
    "q5_remains_immutable_fail": true,
    "no_new_method_qualified": true,
    "no_empirical_data": true,
    "no_flower_colour_outcome": true,
    "no_causal_geometry_claim": true,
    "no_universal_robustness_claim": true
  }
}
