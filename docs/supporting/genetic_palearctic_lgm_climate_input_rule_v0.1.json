{
  "schema": "ttf_genetic_palearctic_lgm_climate_input_rule_v0.1",
  "status": "FROZEN_BEFORE_ANY_PALAEARCTIC_LGM_CLIMATE_EXTRACTION_OR_RELATION_RESULT",
  "frozen_on": "2026-09-29",
  "parent_rule": "docs/supporting/genetic_palearctic_lgm_subpanel_rule_v0.1.json",
  "external_data_rule": "docs/supporting/genetic_palearctic_lgm_external_data_rule_v0.1.json",
  "unit_rule": "docs/supporting/genetic_palearctic_lgm_climate_unit_rule_v0.1.json",
  "grid": {
    "crs": "EPSG:4326",
    "resolution_degrees": 0.1,
    "global_centroid_origin": {
      "longitude": -179.95,
      "latitude": -89.95
    },
    "longitude_centres_formula": "-179.95 + 0.1*i, i=0..3599",
    "latitude_centres_formula": "-89.95 + 0.1*j, j=0..1799",
    "realm_mask": "centroid intersects frozen RESOLVE 2017 Palearctic union",
    "climate_validity": "retain only cells finite and not nodata in all four current CHELSA V2.1 rasters and all four 21-ka TraCE21k rasters",
    "paleocoastline_reconstruction": false,
    "interpretation": "climatic suitability on the fixed contemporary Palearctic terrestrial realm mask, not a reconstruction of exposed LGM shelf land"
  },
  "raster_sampling": {
    "apply_GDAL_scale_and_offset_if_present": true,
    "then_apply_frozen_unit_harmonization": true,
    "interpolation": "none; sample containing raster cell at point coordinate"
  },
  "occurrence_climate_validity": {
    "start_from": "frozen Palearctic-filtered, deduplicated, 10-km-thinned GBIF occurrences",
    "drop_row_if_any_current_bio1_bio7_bio12_bio15_value_is_nodata_or_nonfinite": true,
    "minimum_rows_after_climate_validity_per_species": 30,
    "drop_species_below_minimum": true,
    "backfill": false,
    "resplit": false,
    "after_drop_require": {
      "minimum_total_species": 40,
      "minimum_source_clusters": 20,
      "minimum_target_clusters": 20
    },
    "failure": "NOT_EVALUABLE_PALAEARCTIC_LGM_CLIMATE_COVERAGE"
  },
  "compatibility_diagnostic": {
    "compare_TraCE_0BP_to_CHELSA_V2_1_current": true,
    "same_grid": true,
    "report": [
      "pearson_correlation",
      "median_difference",
      "q05_difference",
      "q95_difference"
    ],
    "diagnostic_only": true
  },
  "response_firewall": {
    "species_level_genetic_scores_used": false,
    "pairwise_subpanel_T_st_computed": false,
    "beta_LGM_computed": false
  }
}
